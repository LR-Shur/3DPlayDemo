<module name="game">
    <enum name="EItemCategory" comment="物品分类">
        <var name="MATERIAL" alias="材料" value="1"/>
        <var name="CONSUMABLE" alias="消耗品" value="2"/>
        <var name="EQUIPMENT" alias="装备" value="3"/>
        <var name="QUEST" alias="任务物品" value="4"/>
    </enum>

    <enum name="EActiveItemEffect" comment="主动道具效果">
        <var name="NONE" alias="无" value="0"/>
        <var name="HEAL" alias="回血" value="1"/>
        <var name="GRENADE" alias="手雷" value="2"/>
        <var name="ELEMENTAL_GRENADE" alias="元素手雷" value="3"/>
        <var name="SELF_BUFF" alias="自身增益" value="4"/>
        <var name="MAGNET" alias="聚怪" value="5"/>
        <var name="FREEZE" alias="冻结" value="6"/>
    </enum>

    <enum name="EEquipmentSlot" comment="装备槽位">
        <var name="WEAPON" alias="武器" value="1"/>
        <var name="ARMOR" alias="盔甲" value="2"/>
        <var name="SHOES" alias="鞋子" value="3"/>
        <var name="HELMET" alias="头盔" value="4"/>
        <var name="GLOVES" alias="手套" value="5"/>
        <var name="ACCESSORY" alias="饰品" value="6"/>
    </enum>

    <enum name="EElement" comment="伤害元素">
        <var name="NONE" alias="无" value="0"/>
        <var name="FIRE" alias="火" value="1"/>
        <var name="WATER" alias="水" value="2"/>
        <var name="WIND" alias="风" value="3"/>
        <var name="EARTH" alias="地" value="4"/>
        <var name="ICE" alias="冰" value="5"/>
        <var name="ELECTRIC" alias="雷" value="6"/>
    </enum>

    <enum name="EEquipmentEffectTrigger" comment="装备效果触发时机">
        <var name="ON_HIT" alias="命中" value="1"/>
        <var name="ON_DODGE" alias="闪避" value="2"/>
        <var name="ON_TAKE_DAMAGE" alias="受击" value="3"/>
        <var name="ON_LOW_HEALTH" alias="低生命" value="4"/>
        <var name="ON_MARK_REACHED" alias="标记满层" value="5"/>
    </enum>

    <enum name="EStatType" comment="装备和套装修改的属性">
        <var name="MAX_HEALTH" alias="最大生命" value="0"/>
        <var name="ATTACK" alias="攻击" value="1"/>
        <var name="DEFENSE" alias="防御" value="2"/>
        <var name="CRIT_RATE" alias="暴击率" value="3"/>
        <var name="CRIT_DAMAGE" alias="暴击伤害" value="4"/>
        <var name="ELECTRIC_DAMAGE_BONUS" alias="雷属性伤害" value="5"/>
    </enum>

    <enum name="EStatModifierOperation" comment="属性词条运算方式">
        <var name="FLAT" alias="固定值" value="0"/>
        <var name="ADDITIVE_PERCENT" alias="加算百分比" value="1"/>
        <var name="MULTIPLICATIVE_PERCENT" alias="乘算百分比" value="2"/>
    </enum>

    <bean name="Item" comment="背包物品基础配置">
        <var name="id" type="string" comment="稳定物品 ID"/>
        <var name="name" type="string" comment="显示名称"/>
        <var name="category" type="EItemCategory"/>
        <var name="quality" type="int"/>
        <var name="max_stack" type="int"/>
        <var name="icon" type="string"/>
        <var name="description" type="string"/>
    </bean>
    <table name="TbItem" value="Item" input="items.csv" comment="物品表"/>

    <bean name="ActiveItem" comment="主动道具快捷栏配置">
        <var name="id" type="string"/>
        <var name="item_id" type="string"/>
        <var name="effect" type="EActiveItemEffect"/>
        <var name="element" type="EElement"/>
        <var name="value" type="float"/>
        <var name="cooldown" type="float"/>
        <var name="radius" type="float"/>
        <var name="buff_id" type="string"/>
        <var name="duration" type="float"/>
        <var name="magnitude" type="float"/>
        <var name="stack_amount" type="int"/>
        <var name="max_stacks" type="int"/>
    </bean>
    <table name="TbActiveItem" value="ActiveItem" input="active_items.csv" comment="主动道具表"/>

    <bean name="Equipment" comment="装备属性配置">
        <var name="id" type="string"/>
        <var name="name" type="string"/>
        <var name="slot" type="EEquipmentSlot"/>
        <var name="quality" type="int"/>
        <var name="attack" type="int"/>
        <var name="defense" type="int"/>
        <var name="max_health" type="int"/>
        <var name="icon" type="string"/>
    </bean>
    <table name="TbEquipment" value="Equipment" input="equipment.csv" comment="装备表"/>

    <bean name="EquipmentSet" comment="装备套装基础信息">
        <var name="id" type="string"/>
        <var name="name" type="string"/>
    </bean>
    <table name="TbEquipmentSet" value="EquipmentSet" input="equipment_sets.csv" comment="装备套装表"/>

    <bean name="EquipmentSetMember" comment="装备与套装关系">
        <var name="id" type="string"/>
        <var name="equipment_id" type="string"/>
        <var name="set_id" type="string"/>
    </bean>
    <table name="TbEquipmentSetMember" value="EquipmentSetMember" input="equipment_set_members.csv" comment="装备套装关系表"/>

    <bean name="EquipmentSetBonus" comment="套装件数奖励词条；一行对应一个属性词条">
        <var name="id" type="string"/>
        <var name="set_id" type="string"/>
        <var name="required_piece_count" type="int"/>
        <var name="stat_type" type="EStatType"/>
        <var name="operation" type="EStatModifierOperation"/>
        <var name="value" type="float"/>
    </bean>
    <table name="TbEquipmentSetBonus" value="EquipmentSetBonus" input="equipment_set_bonuses.csv" comment="套装奖励词条表"/>

    <bean name="EquipmentEffect" comment="装备元素与 Buff 效果">
        <var name="id" type="string"/>
        <var name="equipment_id" type="string"/>
        <var name="trigger" type="EEquipmentEffectTrigger"/>
        <var name="element" type="EElement"/>
        <var name="buff_id" type="string"/>
        <var name="duration" type="float"/>
        <var name="magnitude" type="float"/>
        <var name="stack_amount" type="int"/>
        <var name="max_stacks" type="int"/>
        <var name="cooldown" type="float"/>
    </bean>
    <table name="TbEquipmentEffect" value="EquipmentEffect" input="equipment_effects.csv" comment="装备效果表"/>

    <bean name="EnemyArchetype" comment="敌人原型数值">
        <var name="id" type="string"/>
        <var name="name" type="string"/>
        <var name="prefab_location" type="string"/>
        <var name="max_health" type="int"/>
        <var name="attack" type="int"/>
        <var name="defense" type="int"/>
        <var name="move_speed" type="float"/>
    </bean>
    <table name="TbEnemyArchetype" value="EnemyArchetype" input="enemy_archetypes.csv" comment="敌人原型表"/>

</module>
