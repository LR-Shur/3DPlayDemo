  _dialogueId: dialogue_rusk_first_meet
  _title: "\u4E0E Rusk \u7684\u521D\u6B21\u4F1A\u9762"
  _entryNodeId: wake_up
  _nodes:
  - _nodeId: wake_up
    _kind: 0
    _speakerId: character.rusk
    _text: "\u9192\u4E86\uFF1F\u8FD9\u91CC\u5E76\u4E0D\u5B89\u5168\u3002\u80FD\u7AD9\u8D77\u6765\u7684\u8BDD\uFF0C\u5C31\u5148\u628A\u5251\u63E1\u7A33\u3002"
    _nextNodeId: first_decision
    _choices: []
    _conditions: []
    _commands: []
  - _nodeId: first_decision
    _kind: 1
    _speakerId: 
    _text: "\u4F60\u51C6\u5907\u600E\u4E48\u56DE\u7B54\uFF1F"
    _nextNodeId: 
    _choices:
    - _choiceId: accept_help
      _text: "\u6211\u6765\u5E2E\u5FD9\u3002"
      _nextNodeId: accepted
      _conditions: []
      _commands:
      - _typeId: set_variable
        _key: story.rusk_help_accepted
        _value: true
    - _choiceId: ask_situation
      _text: "\u5148\u544A\u8BC9\u6211\u8FD9\u91CC\u53D1\u751F\u4E86\u4EC0\u4E48\u3002"
      _nextNodeId: explanation
      _conditions: []
      _commands: []
    _conditions: []
    _commands: []
  - _nodeId: explanation
    _kind: 0
    _speakerId: character.rusk
    _text: "\u5931\u63A7\u7684\u4EE5\u592A\u88C5\u7F6E\u5F15\u6765\u4E86\u654C\u4EBA\u3002\u5173\u6389\u5B83\u4E4B\u524D\uFF0C\u8857\u533A\u4E0D\u4F1A\u5B89\u9759\u3002"
    _nextNodeId: second_decision
    _choices: []
    _conditions: []
    _commands: []
  - _nodeId: second_decision
    _kind: 1
    _speakerId: 
    _text: "\u542C\u5B8C\u8BF4\u660E\u540E\uFF0C\u4F60\u51B3\u5B9A\u2026\u2026"
    _nextNodeId: 
    _choices:
    - _choiceId: accept_after_explanation
      _text: "\u660E\u767D\u4E86\uFF0C\u6211\u6765\u5904\u7406\u3002"
      _nextNodeId: accepted
      _conditions: []
      _commands:
      - _typeId: set_variable
        _key: story.rusk_help_accepted
        _value: true
    - _choiceId: leave_for_now
      _text: "\u6211\u8FD8\u9700\u8981\u51C6\u5907\u4E00\u4E0B\u3002"
      _nextNodeId: leave
      _conditions: []
      _commands: []
    _conditions: []
    _commands: []
  - _nodeId: accepted
    _kind: 0
    _speakerId: character.rusk
    _text: "\u5F88\u597D\u3002\u522B\u901E\u5F3A\uFF0C\u6211\u4F1A\u5728\u540E\u65B9\u76EF\u7740\u80FD\u91CF\u8BFB\u6570\u3002"
